---

<section id="about" class="py-20 bg-white dark:bg-secondary-900">
  <div class="container mx-auto px-4">
    <div class="flex flex-col md:flex-row gap-12 items-center">
      <!-- Image column -->
      <div class="w-full md:w-1/2" data-aos="fade-right">
        <div class="relative">
          <img 
            src="https://images.pexels.com/photos/2280165/pexels-photo-2280165.jpeg?auto=compress&cs=tinysrgb&w=1600" 
            alt="Decorative lighting design" 
            class="rounded-lg shadow-xl w-full h-auto"
          />
          <div class="absolute -bottom-4 -right-4 bg-accent-500 text-white px-6 py-2 rounded-lg shadow-lg">
            <p class="font-bold">4+ Years Experience</p>
          </div>
        </div>
      </div>
      
      <!-- Content column -->
      <div class="w-full md:w-1/2" data-aos="fade-left">
        <h2 class="text-3xl font-bold mb-6 inline-block relative">
          About SANTEJ Lights
          <span class="absolute bottom-0 left-0 w-1/2 h-1 bg-primary-500"></span>
        </h2>
        
        <p class="text-lg mb-6 text-secondary-700 dark:text-secondary-200">
          Welcome to SANTEJ Lights – your trusted partner in decorative lighting solutions. For over 4 years, we've been delivering high-quality LED light fixtures and decorative poles to residential townships, landscaping projects, and industrial spaces.
        </p>
        
        <p class="text-lg mb-8 text-secondary-700 dark:text-secondary-200">
          We specialize in custom lighting solutions, tailoring our products to meet your specific requirements. Whether it's customized decorative poles or specialized LED lights, our team is here to bring your vision to light.
        </p>
        
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-secondary-100 dark:bg-secondary-800 p-4 rounded-lg">
            <div class="text-primary-500 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
              </svg>
            </div>
            <h3 class="font-bold text-lg mb-1">Custom Design</h3>
            <p class="text-secondary-700 dark:text-secondary-300">Tailored lighting solutions for your needs</p>
          </div>
          
          <div class="bg-secondary-100 dark:bg-secondary-800 p-4 rounded-lg">
            <div class="text-primary-500 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" />
              </svg>
            </div>
            <h3 class="font-bold text-lg mb-1">Premium Quality</h3>
            <p class="text-secondary-700 dark:text-secondary-300">Durable and energy-efficient products</p>
          </div>
          
          <div class="bg-secondary-100 dark:bg-secondary-800 p-4 rounded-lg">
            <div class="text-primary-500 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
              </svg>
            </div>
            <h3 class="font-bold text-lg mb-1">Expert Installation</h3>
            <p class="text-secondary-700 dark:text-secondary-300">Professional setup and maintenance</p>
          </div>
          
          <div class="bg-secondary-100 dark:bg-secondary-800 p-4 rounded-lg">
            <div class="text-primary-500 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
              </svg>
            </div>
            <h3 class="font-bold text-lg mb-1">Competitive Pricing</h3>
            <p class="text-secondary-700 dark:text-secondary-300">Excellent value for premium lights</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>