<section id="contact" class="py-20 bg-secondary-100 dark:bg-secondary-800">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16" data-aos="fade-up">
      <h2 class="text-3xl font-bold mb-6 inline-block relative">
        Contact Us
        <span class="absolute bottom-0 left-1/4 w-1/2 h-1 bg-primary-500"></span>
      </h2>
      <p class="text-lg max-w-2xl mx-auto text-secondary-700 dark:text-secondary-200">
        Have questions or interested in our services? Get in touch with us 
        and our team will be happy to assist you.
      </p>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Contact Information -->
      <div class="bg-white dark:bg-secondary-900 rounded-lg shadow-lg p-8" data-aos="fade-right">
        <h3 class="text-2xl font-bold mb-6 text-secondary-900 dark:text-white">Get In Touch</h3>
        
        <div class="space-y-6">
          <div class="flex items-start">
            <div class="bg-primary-100 dark:bg-primary-900/20 p-3 rounded-lg mr-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-primary-600 dark:text-primary-400">
