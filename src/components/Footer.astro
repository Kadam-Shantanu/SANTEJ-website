            <a href="mailto:info@santej.in" class="text-secondary-300 hover:text-white transition-colors">info@santej.in</a>
          </li>
          <li class="flex items-start">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-accent-400 mr-2 mt-0.5">
