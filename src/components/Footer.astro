      <!-- Quick Links -->
      <div>
        <h4 class="text-xl font-bold mb-4">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="#home" class="text-secondary-300 hover:text-white transition-colors">Home</a></li>
          <li><a href="#about" class="text-secondary-300 hover:text-white transition-colors">About Us</a></li>
          <li><a href="#services" class="text-secondary-300 hover:text-white transition-colors">Services</a></li>
          <li><a href="#" class="text-secondary-300 hover:text-white transition-colors">Projects</a></li>
