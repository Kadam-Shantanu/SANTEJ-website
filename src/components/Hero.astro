---
---

<section id="home" class="relative h-screen flex items-center justify-center overflow-hidden">
  <!-- Background image with overlay -->
  <div class="absolute inset-0 z-0">
    <img 
      src="https://images.pexels.com/photos/1090972/pexels-photo-1090972.jpeg?auto=compress&cs=tinysrgb&w=1600" 
      alt="Decorative lights background" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-secondary-900/70 to-secondary-950/90"></div>
  </div>

  <!-- Light particles animation -->
  <div class="light-particles absolute inset-0 z-10"></div>
  
  <!-- Content -->
  <div class="container relative z-20 text-center px-4" data-aos="fade-up">
    <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
      Illuminate Your World
    </h1>
    <p class="text-xl text-white/90 max-w-2xl mx-auto mb-8">
      Premium decorative lighting solutions for residential townships, landscaping projects, and industrial spaces.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a 
        href="#services" 
        class="px-8 py-3 bg-accent-500 hover:bg-accent-600 text-white font-medium rounded-lg transition-all duration-300 transform hover:scale-105"
      >
        Our Services
      </a>
      <a 
        href="#contact" 
        class="px-8 py-3 bg-transparent hover:bg-white/10 text-white border border-white rounded-lg transition-all duration-300"
      >
        Contact Us
      </a>
    </div>
  </div>
  
  <!-- Scroll down indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 text-white animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 5.25l-7.5 7.5-7.5-7.5m15 6l-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</section>

<style>
  .light-particles {
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.3) 0%, transparent 8px),
      radial-gradient(circle at 75% 44%, rgba(255, 255, 255, 0.2) 0%, transparent 6px),
      radial-gradient(circle at 46% 52%, rgba(255, 255, 255, 0.3) 0%, transparent 4px),
      radial-gradient(circle at 61% 68%, rgba(255, 255, 255, 0.4) 0%, transparent 7px),
      radial-gradient(circle at 12% 10%, rgba(255, 255, 255, 0.1) 0%, transparent 10px),
      radial-gradient(circle at 85% 15%, rgba(255, 255, 255, 0.2) 0%, transparent 12px),
      radial-gradient(circle at 30% 80%, rgba(255, 255, 255, 0.3) 0%, transparent 5px),
      radial-gradient(circle at 40% 25%, rgba(255, 255, 255, 0.2) 0%, transparent 9px),
      radial-gradient(circle at 80% 85%, rgba(255, 255, 255, 0.2) 0%, transparent 5px);
    animation: float 15s ease-in-out infinite;
    opacity: 0.7;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) translateX(0); }
    25% { transform: translateY(-10px) translateX(5px); }
    50% { transform: translateY(5px) translateX(-5px); }
    75% { transform: translateY(-5px) translateX(-10px); }
  }
</style>